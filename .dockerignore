# Build artifacts
node_modules/
.pnpm-store/
dist/
.pledge-cache/
target/
.turbo/
.next/

# App build output (regenerated by Docker build)
.pledge/
apps/*/.pledge/

# Version control & metadata
.git/
.gitignore
.github/
.pledge/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Tests & coverage
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
coverage/
.test-config.json
test-config.json

# Docs (not needed at runtime)
docs/
*.md
!packages/*/README.md

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Tarballs
*.tgz

# Local env (never bake secrets into images)
.env
.env.*
!.env.example

# Changesets (release tooling, not runtime)
.changeset/
