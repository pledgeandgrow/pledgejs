{
  "name": "pledgestack",
  "version": "0.1.10",
  "private": true,
  "description": "A full-stack React framework with file-based routing, SSR, SSG, RSC, API routes, middleware, and edge runtime support.",
  "scripts": {
    "dev": "node packages/cli/dist/bin.js dev",
    "build": "node packages/cli/dist/bin.js build",
    "build:packages": "pnpm --filter \"./packages/cli\" run build",
    "build:all": "pnpm build:packages && pnpm build",
    "lint": "node packages/cli/dist/bin.js lint",
    "clean": "node packages/cli/dist/bin.js clean",
    "typecheck": "node packages/cli/dist/bin.js typecheck",
    "test": "node packages/cli/dist/bin.js test",
    "audit": "pnpm audit --audit-level=high",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.18.0",
    "pledgepack": "^0.2.8",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "author": "PledgeStack Contributors",
  "homepage": "https://github.com/pledgeandgrow/pledgestack#readme",
  "bugs": {
    "url": "https://github.com/pledgeandgrow/pledgestack/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pledgeandgrow/pledgestack.git"
  },
  "keywords": [
    "pledgestack",
    "react",
    "framework",
    "ssr",
    "ssg",
    "rsc",
    "fullstack"
  ]
}
