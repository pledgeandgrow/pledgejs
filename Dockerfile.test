# Generated by PledgeStack CLI — test image variant (port 8080, .pledge/server.js entry)
# See Dockerfile for the production variant. Both share the same multi-stage pattern.
FROM node:20-alpine AS base
RUN corepack enable
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ ./packages/
RUN find packages -type f \! -name 'package.json' \! -name 'tsconfig*.json' -delete 2>/dev/null || true
RUN pnpm install --frozen-lockfile

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY . .
RUN pnpm build:packages
RUN node packages/cli/dist/bin.js build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 pledgestack
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ ./packages/
RUN find packages -type f \! -name 'package.json' \! -name 'tsconfig*.json' -delete 2>/dev/null || true
RUN pnpm install --prod --frozen-lockfile
COPY --from=builder /app/public ./public
COPY --from=builder /app/.pledge ./.pledge
COPY --from=builder /app/package.json ./package.json
USER pledgestack
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:8080/health || exit 1
CMD ["node", ".pledge/server.js"]
