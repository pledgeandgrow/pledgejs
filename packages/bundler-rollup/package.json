{
  "name": "pledgestack-bundler-rollup",
  "version": "0.2.0",
  "description": "Rollup bundler adapter for PledgeStack — use Rollup instead of PledgePack",
  "keywords": [
    "pledgestack"
  ],
  "homepage": "https://github.com/pledgeandgrow/pledgejs/tree/main/packages/bundler-rollup#readme",
  "bugs": {
    "url": "https://github.com/pledgeandgrow/pledgejs/issues"
  },
  "license": "MIT",
  "author": "PledgeStack Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/pledgeandgrow/pledgejs.git",
    "directory": "packages/bundler-rollup"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build && node ../../scripts/bundle-package.mjs",
    "dev": "tsc --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "pledgestack-shared": "workspace:*",
    "pledgestack-core": "workspace:*",
    "esbuild": "^0.24.0"
  },
  "peerDependencies": {
    "rollup": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "rollup": {
      "optional": false
    }
  },
  "devDependencies": {
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "rollup": "^4.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-commonjs": "^28.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
