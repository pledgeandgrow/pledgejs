{
  "name": "pledgestack-core",
  "version": "1.0.0-rc.0",
  "description": "Core framework for PledgeStack — routing, rendering, and build pipeline",
  "keywords": [
    "pledgestack",
    "react",
    "framework",
    "core",
    "routing",
    "rendering",
    "rsc",
    "ssr"
  ],
  "homepage": "https://github.com/pledgeandgrow/pledgejs/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/pledgeandgrow/pledgejs/issues"
  },
  "license": "MIT",
  "author": "PledgeStack Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/pledgeandgrow/pledgejs.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    },
    "./fs": {
      "types": "./dist/fs/index.d.ts",
      "import": "./dist/fs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build && node ../../scripts/bundle-package.mjs",
    "dev": "tsc --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "pledgestack-shared": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "comment:optionalRuntimeDeps": "The PSX integration JS fallbacks use optional runtime packages (pg, mysql2, redis, ioredis, argon2, bcryptjs, jsonwebtoken, sharp, puppeteer, nodemailer, xlsx). They are intentionally NOT declared as peerDependencies or optionalDependencies — pnpm auto-installs optional peers and npm/pnpm would install ~200MB of heavy native modules (puppeteer's Chromium, argon2's compiled addon, sharp's platform binaries) that most users never use. Install only the ones you use; each integration imports its package dynamically and throws a clear error with the exact install command if it is missing."
}
