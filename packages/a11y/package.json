{
  "name": "pledgestack-a11y",
  "version": "0.2.0",
  "description": "Accessibility utilities for PledgeStack — audit, focus management, keyboard nav, RTL, translation management",
  "keywords": [
    "pledgestack"
  ],
  "homepage": "https://github.com/pledgeandgrow/pledgejs/tree/main/packages/a11y#readme",
  "bugs": {
    "url": "https://github.com/pledgeandgrow/pledgejs/issues"
  },
  "license": "MIT",
  "author": "PledgeStack Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/pledgeandgrow/pledgejs.git",
    "directory": "packages/a11y"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build && node ../../scripts/bundle-package.mjs",
    "dev": "tsc --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
