    "create-pledge-app",
    "pledgestack",
    "scaffold",
    "cli",
    "starter",
    "template"
  ],
  "homepage": "https://github.com/pledgeandgrow/pledgejs/tree/main/packages/create-pledge-app#readme",
  "bugs": {
