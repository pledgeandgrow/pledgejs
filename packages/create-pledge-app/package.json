  },
  "license": "MIT",
  "author": "PledgeStack Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/pledgeandgrow/pledgejs.git",
    "directory": "packages/create-pledge-app"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
