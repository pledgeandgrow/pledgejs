{
  "name": "pledgestack-shared",
  "version": "0.0.2",
  "description": "Shared types and utilities for PledgeStack",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "rimraf": "^6.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0"
  },
  "license": "MIT",
  "author": "PledgeStack Contributors",
  "homepage": "https://github.com/pledgeandgrow/pledgejs#readme",
  "bugs": {
    "url": "https://github.com/pledgeandgrow/pledgejs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pledgeandgrow/pledgejs.git",
    "directory": "packages/shared"
  },
  "keywords": [
    "pledgestack",
    "react",
    "framework",
    "shared",
    "types"
  ],
  "private": true
}
