{
  "name": "pledgestack-server",
  "version": "0.2.1",
  "description": "Node.js and Edge server runtime for PledgeStack",
  "keywords": [
    "pledgestack",
    "react",
    "framework",
    "server",
    "node",
    "edge",
    "ssr"
  ],
  "homepage": "https://github.com/pledgeandgrow/pledgejs/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/pledgeandgrow/pledgejs/issues"
  },
  "license": "MIT",
  "author": "PledgeStack Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/pledgeandgrow/pledgejs.git",
    "directory": "packages/server"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build && node ../../scripts/bundle-package.mjs",
    "dev": "tsc --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "esbuild": "^0.24.0",
    "pledgepack": "^0.4.2",
    "pledgestack-auth": "workspace:*",
    "pledgestack-core": "workspace:*",
    "pledgestack-rss": "workspace:*",
    "pledgestack-shared": "workspace:*",
    "pledgestack-sitemap": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "sharp": "^0.35.4",
    "typescript": "^5.7.0",
    "ws": "8.21.3"
  },
  "peerDependencies": {
    "ws": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
